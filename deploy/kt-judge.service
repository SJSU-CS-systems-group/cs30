[Unit]
Description=CS30 Kotlin Judge
After=snap.docker.dockerd.service
Requires=snap.docker.dockerd.service

[Service]
User=cs30judge
Group=cs30problems
WorkingDirectory=/opt/cs30
ExecStart=/usr/bin/java -jar /opt/cs30/current/kt-judge.jar \
  --server.address=127.0.0.1 --server.ssl.enabled=false
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
