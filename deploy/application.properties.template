# Rendered by the deploy-prod job in .github/workflows/ci.yml on every push to main.
# Only DB_PASSWORD and GOOGLE_CLIENT_SECRET are substituted at deploy time (from
# GitHub Environment secrets on the `production` environment) — everything else
# here is non-secret and safe to check into the repo. Values below are filled in
# for server 7 (cs-reed-07.homeofcode.com, deploy user "divyam") — edit directly
# and commit if any of that changes.

server.port=8443

# Leave disabled until you have a real cert for server 7's hostname.
# server.ssl.enabled=true
# server.ssl.certificate=/home/divyam/cs30/ssl/server.crt
# server.ssl.certificate-private-key=/home/divyam/cs30/ssl/server.key

server.compression.enabled=true
server.compression.mime-types=text/html,text/css,text/plain,application/javascript,text/javascript,application/json,application/wasm,image/svg+xml
server.compression.min-response-size=1024

spring.datasource.url=jdbc:postgresql://localhost:5432/cs30db
spring.datasource.username=cs30
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

# Client ID isn't secret (it's visible in the browser's OAuth redirect URL) so it's
# fine to hardcode here directly once you know it. Same OAuth client as cs-reed-02 —
# make sure the redirect-uri below is added to that client's Authorized redirect URIs
# in Google Cloud Console, or login will fail with a redirect_uri_mismatch.
google.client-id=160623963910-reen5hga1n171tjoc224snv4ktiv9i8m.apps.googleusercontent.com
google.client-secret=${GOOGLE_CLIENT_SECRET}
google.redirect-uri=https://cs-reed-07.homeofcode.com:8443/callback

# Backend commits student code via SSH to itself, so this must be `localhost`.
git.server.ssh-host=localhost
git.server.ssh-user=divyam

# Judge runs co-located on server 7.
judge.url=http://localhost:8000

server.servlet.session.timeout=1h

cs30.backend.url=https://cs-reed-07.homeofcode.com:8443

cs30.allowed-ips=

docker.path=/usr/bin/docker

editor.max-custom-test-cases=1
